rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function campus() { return "WCI_UNNAO_MAIN"; }

    match /system/lockdown {
      allow read: if isAuth();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /students/{id} {
      allow read: if isAuth();
      allow write: if false; // admin via Cloud Functions only
    }

    match /exam_answer_vault/{id} {
      allow read, write: if false; // hard-denied to all clients
    }

    match /exam_questions_sanitized/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}